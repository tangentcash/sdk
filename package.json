{
  "name": "tangentsdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Tangent Cash",
  "license": "MIT",
  "exports": {
    ".": { "types:": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./algorithm": { "types:": "./dist/algorithm.d.ts", "import": "./dist/algorithm.js" },
    "./schema": { "types:": "./dist/schema.d.ts", "import": "./dist/schema.js" },
    "./serialization": { "types:": "./dist/serialization.d.ts", "import": "./dist/serialization.js" },
    "./text": { "types:": "./dist/text.d.ts", "import": "./dist/text.js" },
    "./ui": { "types:": "./dist/ui.d.ts", "import": "./dist/ui.js" },
    "./types": { "types:": "./dist/types.d.ts", "import": "./dist/types.js" },
    "./rpc": { "types:": "./dist/rpc.d.ts", "import": "./dist/rpc.js" },
    "./assetlist": { "types:": "./dist/assetlist.d.ts", "import": "./dist/assetlist.js" },
    "./whitelist": { "types:": "./dist/whitelist.d.ts", "import": "./dist/whitelist.js" }
  },
  "scripts": {
    "make": "tsc && node build"
  },
  "dependencies": {
    "@ethersproject/random": "5.8.0",
    "@noble/hashes": "1.8.0",
    "@radixdlt/uint256": "1.1.0",
    "@scure/bip39": "1.6.0",
    "@types/libsodium-wrappers": "0.7.14",
    "@types/secp256k1": "4.0.6",
    "bech32": "2.0.0",
    "bignumber.js": "9.3.1",
    "js-base64": "3.7.8",
    "secp256k1": "5.0.1",
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "json-minify": "1.0.0"
  }
}
